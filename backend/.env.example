PORT=5000
HOST=127.0.0.1
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=safespeak_db
DB_USER=safespeak_app
DB_PASSWORD=your_runtime_role_password

NODE_ENV=development
# Set a random secret of at least 32 bytes for hosted use or to keep sessions across local restarts.
JWT_SECRET=
ENABLE_TEST_REGISTRATION=true
TRUST_LOOPBACK_PROXY=false

# Private attachment storage (relative to the backend folder, or an absolute path).
UPLOAD_DIR=storage/uploads
